# Copy this file to .env and fill in your keys. Never commit .env.

# --- Which AI provider runs the models ---
# gemini = FREE (default). Get a key at https://aistudio.google.com/apikey
# openai = paid (the provider used in the course). Needs OPENAI_API_KEY.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=

# --- Financial ratios (Labs 2A and 2F) — FREE plan ---
# Sign up at https://site.financialmodelingprep.com/register , then copy the key from
# https://site.financialmodelingprep.com/developer/docs/dashboard
FINANCIAL_MODELING_PREP_API_KEY=

# --- Optional ---
OPENAI_API_KEY=
HF_TOKEN=

# Optional: tickers agents may not query (comma-separated compliance list)
RESTRICTED_TICKERS=

# Optional: use any other OpenAI-compatible server (LLM_PROVIDER=custom)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_EMBEDDING_MODEL=

# Optional: override models (e.g. gemini-2.5-flash-lite has higher free limits)
# MODEL_SUMMARY=gemini-2.5-flash
# MODEL_SMART=gemini-2.5-flash
# MODEL_AGENT=gemini-2.5-flash
# MODEL_REACT=gemini-2.5-flash
# MODEL_NEWS=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
